# LinkDooni site pages
# Local PHP pages are served directly; unknown paths redirect to cloub.io

RewriteEngine On

# Local /plan page (must not bounce to cloub.io)
RewriteRule ^plan/?$ plan.php [L]

# Serve existing files and directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirect everything else to cloub.io with the same path
RewriteRule ^(.*)$ https://cloub.io/$1 [R=302,L]

DirectoryIndex index.php

Options -Indexes
