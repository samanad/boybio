<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView android:id="@+id/header" android:text="Account settings" android:textSize="22sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" />
        <EditText android:id="@+id/name" android:hint="Name" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/email" android:hint="Email" android:inputType="textEmailAddress" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/timezone" android:hint="Timezone (IANA)" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/anti" android:hint="Anti-phishing code" android:maxLength="8" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/newsletter" android:text="Newsletter" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/oldPassword" android:hint="Current password (to change)" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/newPassword" android:hint="New password" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/billingName" android:hint="Billing name" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/billingAddress" android:hint="Billing address" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/billingCity" android:hint="City" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/billingCountry" android:hint="Country code (US)" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" />
        <Button android:id="@+id/save" android:text="Save settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <Button android:id="@+id/logout" android:text="Sign out" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
