# Vendor dependencies
product/vendor/

# Uploads and user files
# Ignore most uploads, but allow static assets (logos, favicons) that existed before offload storage
product/uploads/*
# Allow static assets in main/ folder (logos, favicons, etc.)
!product/uploads/main/
# Allow PWA assets
!product/uploads/pwa/
# Allow favicons folder
!product/uploads/favicons/
# But ignore cache
product/uploads/cache/
# Ignore user-generated content
product/uploads/users/
product/uploads/files/
product/uploads/avatars/
product/uploads/block_images/
product/uploads/block_thumbnail_images/
product/uploads/backgrounds/
product/uploads/products_files/
product/uploads/vcards_avatars/
product/uploads/splash_pages/
product/uploads/blog/
product/uploads/offline_payment_proofs/
product/uploads/chats_assistants/
product/uploads/chats_images/
product/uploads/images/
product/uploads/qr_code/
product/uploads/qr_code_logo/
product/uploads/qr_code_default_image/
product/uploads/service_workers/
product/uploads/dynamic_og_images/
product/uploads/transcriptions/

# Cache files
*.cache

# Configuration files with sensitive data
product/config.php
product/app/config/config.php

# Plugins folder - allow entire folder to be tracked
# (Remove this line if you want to track plugins)
# product/plugins/

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Archive files
*.zip
*.tar
*.tar.gz
*.rar

# Large database files
*.mmdb
product/app/includes/GeoLite2-*.mmdb

# Log files
*.log

# Temporary files
*.tmp
*.temp

# Install files (if not needed in repo)
product/install/installed

# Environment files
.env
.env.local

# LinkDooni custom landing page (git-ignored)
linkdoo/


# product_stage test root (same rules as product)
product_stage/vendor/
product_stage/uploads/*
!product_stage/uploads/main/
!product_stage/uploads/pwa/
!product_stage/uploads/favicons/
product_stage/uploads/cache/
product_stage/config.php
product_stage/config-*.php
